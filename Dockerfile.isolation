FROM python:3.12-slim-bookworm
WORKDIR /app
COPY src/spx_research/isolation/protocol.py src/spx_research/isolation/worker.py src/spx_research/isolation/gateway_server.py src/spx_research/isolation/egress_proxy.py /app/
COPY src/spx_research/resources/contracts /app/contracts
RUN mkdir -p /run/spx /run/egress && chown -R 65532:65532 /run/spx /run/egress
USER 65532:65532
ENTRYPOINT ["python", "/app/worker.py"]
