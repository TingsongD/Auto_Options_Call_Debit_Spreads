{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "2.1"
      ]
    },
    "actor_role": {
      "type": "string",
      "enum": [
        "SPREAD",
        "MANAGER"
      ]
    },
    "episode_token": {
      "type": "string"
    },
    "decision_token": {
      "type": "string"
    },
    "packet_token": {
      "type": "string"
    },
    "prior_belief_token": {
      "type": "string"
    },
    "clock": {
      "type": "object",
      "properties": {
        "session_index": {
          "type": "integer"
        },
        "minute_from_open": {
          "type": "integer"
        }
      },
      "required": [
        "session_index",
        "minute_from_open"
      ],
      "additionalProperties": false
    },
    "premises": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "metric": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "OBSERVATION",
              "ANNOUNCEMENT",
              "SCHEDULE",
              "SOURCE_FORECAST",
              "DERIVED",
              "APPROVED_RULE"
            ]
          },
          "age_minutes": {
            "type": "integer"
          }
        },
        "required": [
          "token",
          "metric",
          "value",
          "unit",
          "kind",
          "age_minutes"
        ],
        "additionalProperties": false
      }
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "assessment": {
            "type": "string"
          },
          "premise_tokens": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence_label": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "UNASSESSABLE"
            ]
          }
        },
        "required": [
          "token",
          "topic",
          "assessment",
          "premise_tokens",
          "confidence_label"
        ],
        "additionalProperties": false
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "UNKNOWN_FUTURE_POLICY_PATH",
          "UNKNOWN_FUTURE_PRICE_PATH",
          "UNVERIFIED_PROBABILITY",
          "AMBIGUOUS_MACRO",
          "QUOTE_LIMITATION",
          "DISCRETIONARY_LOSS_LIMIT",
          "NONE_IDENTIFIED"
        ]
      }
    },
    "action_menu": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "WAIT",
              "OPEN",
              "HOLD",
              "CLOSE",
              "ALLOCATE",
              "PAUSE_NEW_ALLOCATIONS",
              "RESUME_NEW_ALLOCATIONS",
              "RETIRE_SEARCH_SLOTS",
              "NO_CHANGE"
            ]
          },
          "target_token": {
            "type": [
              "string",
              "null"
            ]
          },
          "limit_option_token": {
            "type": [
              "string",
              "null"
            ]
          },
          "attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "value",
                "unit"
              ],
              "additionalProperties": false
            }
          },
          "required_premise_tokens": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "action_id",
          "kind",
          "target_token",
          "limit_option_token",
          "attributes",
          "required_premise_tokens"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "actor_role",
    "episode_token",
    "decision_token",
    "packet_token",
    "prior_belief_token",
    "clock",
    "premises",
    "assessments",
    "unknowns",
    "action_menu"
  ],
  "additionalProperties": false
}
